OSTROVOK_API_PORT=8080
OSTROVOK_POSTGRES_PORT=5432
DATABASE_URL=postgres://ostrovok_user:super_secret_password@127.0.0.1:5432/ostrovok_travel?sslmode=disable

# Telegram Mini App: проверка подписи initData на сервере.
# Без токена локальный браузер работает. Для продакшена задайте токен бота.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_REQUIRE_INITDATA=true

# Живой LLM (необязательно). Без ключа агент ищет по Postgres правилами.
# OPENAI_API_KEY=
# OSTROVOK_LLM_API_KEY=
# OSTROVOK_LLM_BASE_URL=https://api.openai.com/v1
# OSTROVOK_LLM_MODEL=gpt-4o-mini
